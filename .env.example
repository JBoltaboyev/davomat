# ==========================================
# UrDPI Davomat va Monitoring Tizimi
# Muhit va Server Sozlamalari (.env)
# ==========================================

# Server porti (Standart: 3000)
PORT=3000

# Server host (0.0.0.0 barcha tashqi tarmoq ulanishlarini qabul qiladi)
HOST=0.0.0.0

# Node muhiti (development yoki production)
NODE_ENV=production

# Ilova nomi
APP_NAME=UrDPI Davomat va Monitoring

# ------------------------------------------
# Telegram Bot Sozlamalari (Ixtiyoriy)
# Agar Telegram guruhga haqiqiy hisobot jo'natish kerak bo'lsa to'ldiring:
# ------------------------------------------
# 1. @BotFather orqali bot ochib, uning Tokenini bu yerga yozing:
TELEGRAM_BOT_TOKEN=

# 2. Hisobot borishi kerak bo'lgan guruh yoki kanal Chat ID sini yozing (masalan: -1001234567890):
TELEGRAM_CHAT_ID=
