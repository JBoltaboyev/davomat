{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**,DAVOMAT.xlsx,public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/davomat/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/davomat",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
